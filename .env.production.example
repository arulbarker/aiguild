# Template env PRODUKSI — isi nilai ASLI hanya di Coolify (jangan commit nilai asli).
# File ini hanya contоh/placeholder, aman masuk git.

# --- Sudah ada di prod (jangan diubah kalau sudah jalan) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aiguild
JWT_SECRET=<rahasia-jwt>
TOKEN_SECRET=<rahasia-token>
NEXT_PUBLIC_APP_URL=https://aiguild.online
RESEND_API_KEY=<resend-key>
MAYAR_WEBHOOK_SECRET=<mayar-webhook-secret>
NEXT_PUBLIC_POSTHOG_KEY=<posthog-key>
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=<sentry-dsn>
NODE_ENV=production

# --- BARU untuk rilis membership + voucher ---
ADMIN_EMAIL=mursalinasrul@gmail.com
CRON_SECRET=<acak-panjang>
MAYAR_PAYMENT_URL=https://aiadalahbudak.myr.id/m/ai-guild
NEXT_PUBLIC_MAYAR_PAYMENT_URL=https://aiadalahbudak.myr.id/m/ai-guild
MAYAR_PRODUCT_NAME=<nama-persis-produk-AI-Guild-di-Mayar>
# MAYAR_PRODUCT_ID=<isi setelah konfirmasi dari 1 pembayaran test>
MAYAR_API_KEY=<key-prod-read-write-dari-web.mayar.id>
MAYAR_API_BASE=https://api.mayar.id/hl/v1

# --- BARU untuk integrasi Lynk.id (kelas GAS dijual juga di Lynk.id) ---
